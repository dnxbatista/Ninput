<Window x:Class="Ninput.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ninput"
        mc:Ignorable="d"
        Title="Ninput" Height="100" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Margin="15" Content="Settings" Click="BtnSettings_Click"/>

        <StackPanel Grid.Column="2" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="InputStatus" Text="Input: Enabled"/>
            <TextBlock x:Name="InputName" Text="Keys: ALT + K"/>
        </StackPanel>
    </Grid>
</Window>
